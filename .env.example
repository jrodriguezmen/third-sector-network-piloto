# Clave de la API de Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Clave secreta de Stripe. Empieza con sk_test_ para pruebas y sk_live_ para cobrar de verdad.
STRIPE_SECRET_KEY=sk_test_...

# URL pública de la web (sin barra final). Si no se indica, se deduce de la petición.
SITE_URL=https://tu-proyecto.vercel.app

# Precio por proyecto en céntimos (4900 = 49,00 €)
PRICE_EUR_CENTS=4900

# Versiones que puede generar cada pago
MAX_GENERATIONS=3

# Solo si tu clave de Claude pide un workspace concreto (opcional)
ANTHROPIC_WORKSPACE_ID=

# Códigos de acceso del piloto, separados por comas (generan la matriz completa sin pago)
PILOT_CODES=ONG-EJEMPLO1,ONG-EJEMPLO2

# Modelos de Claude (opcional)
MODEL_PREVIEW=claude-haiku-5-5
MODEL_FULL=claude-sonnet-5-5
